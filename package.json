{
  "name": "ruru-chess",
  "version": "3.0.0",
  "private": true,
  "description": "Ruru Chess — δωρεάν βάση δεδομένων και ανάλυση σκακιού για Windows",
  "license": "GPL-3.0-or-later AND AGPL-3.0-or-later AND AGPL-3.0-only",
  "type": "module",
  "repository": "github:RuruChess/ruru-chess",
  "homepage": "https://ruruchess.com/",
  "bugs": {
    "email": "ruruchessofficial@gmail.com"
  },
  "engines": {
    "node": ">=24.11"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "node --watch src/server/main.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "node src/server/main.ts",
    "electron": "electron electron/main.cjs",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "e2e": "vite build --logLevel warn && node scripts/e2e.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.21",
    "7zip-bin": "^5.2.0",
    "lucide-react": "^1.61.0",
    "pdfjs-dist": "6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "ts-fsrs": "5.4.2",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.4.1",
    "playwright-core": "^1.65.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
