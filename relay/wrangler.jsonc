{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Ruru Chess — «Παρτίδα με φίλο». Τοπικά: npm run dev (http://localhost:8787). Ανέβασμα: npm run deploy.
	"name": "ruru-play",
	"main": "src/worker.ts",
	"routes": [
		{
			"pattern": "play.ruruchess.com",
			"custom_domain": true
		}
	],
	"compatibility_date": "2026-10-01",
	// χωρίς καταγραφή αιτημάτων: τα URL έχουν id χρηστών, ονόματα καλεσμένων και αρχείων (PRIVACY.md)
	"observability": {
		"enabled": false
	},
	"assets": {
		// η σελίδα του φίλου (χτίζεται από το web/ με το `npm run build:web`)
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*",
			"/ws/*",
			"/wa/*",
			"/social"
		]
	},
	// Φίλοι: τα αρχεία που στέλνονται (μόνο PGN σε απλό κείμενο, έως 1 MB, λήγουν σε 7 μέρες). Το `npm run deploy` φτιάχνει
	// μόνο του τον χώρο KV την πρώτη φορά (χωρίς id εδώ)· τοπικά το wrangler dev κρατά τα αρχεία στο .wrangler/.
	"kv_namespaces": [
		{
			"binding": "FILES",
			"id": "d45186353cfc4aba810fd5eda3b6c10e"
		}
	],
	// Όρια ανά IP και λεπτό, κατά της κατάχρησης: νέα δωμάτια, και κλήσεις / συνδέσεις των Φίλων.
	"ratelimits": [
		{
			"name": "ROOMS_LIMIT",
			"namespace_id": "3001",
			"simple": {
				"limit": 20,
				"period": 60
			}
		},
		{
			"name": "SOCIAL_LIMIT",
			"namespace_id": "3002",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"name": "ROOMS",
				"class_name": "GameRoom"
			},
			{
				"name": "ANALYSIS",
				"class_name": "AnalysisRoom"
			},
			// Φίλοι (src/social.ts)
			{
				"name": "DIRECTORY",
				"class_name": "Directory"
			},
			{
				"name": "USERS",
				"class_name": "UserHub"
			},
			{
				"name": "CONVS",
				"class_name": "Conversation"
			},
			{
				"name": "TEAMS",
				"class_name": "Team"
			}
		]
	},
	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": [
				"GameRoom"
			]
		},
		{
			"tag": "v2",
			"new_sqlite_classes": [
				"AnalysisRoom"
			]
		},
		{
			"tag": "v3",
			"new_sqlite_classes": [
				"Directory",
				"UserHub",
				"Conversation"
			]
		},
		// Ομάδες (φάση 2)
		{
			"tag": "v4",
			"new_sqlite_classes": [
				"Team"
			]
		}
	]
}